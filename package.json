{
  "name": "ai-agent-best-practices",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:fast": "playwright test tests/markdown-rendering.test.mjs tests/style-css.test.mjs",
    "test": "playwright test tests/*.test.mjs",
    "verify:fast": "npm run lint && npm run format:check && npm run check:tag-guides && npm run test:fast",
    "verify:full": "npm run lint && npm run format:check && npm run check:tag-guides && npm run build && npm run verify:pages && npm test",
    "verify": "npm run verify:fast",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && npm run build:root && npm run build:tag-guides && npm run build:assets",
    "verify:pages": "node scripts/check-pages-output.mjs",
    "save:singlefile": "node workflow/scripts/save_singlefile.js && node workflow/scripts/build_singlefile_index.js",
    "save:singlefile:dry-run": "node workflow/scripts/save_singlefile.js --dry-run",
    "save:content": "node workflow/scripts/save_content.js",
    "save:content:dry-run": "node workflow/scripts/save_content.js --dry-run",
    "fix:tag-guides": "node workflow/scripts/annotate_tag_guides_fences.js",
    "check:tag-guides": "node workflow/scripts/annotate_tag_guides_fences.js --check",
    "build:tag-guides": "node workflow/scripts/build_tag_guides_html.js",
    "render:github-markdown-style-guide": "node workflow/scripts/render_markdown_file.js workflow/guides/github-markdown-style-guide.md dist/github-markdown-style-guide.html",
    "build:root": "node workflow/scripts/build_root_pages.js",
    "build:assets": "node workflow/scripts/package_dist_assets.js"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@playwright/test": "latest"
  },
  "dependencies": {
    "@mozilla/readability": "latest",
    "csv-parse": "latest",
    "csv-stringify": "latest",
    "github-markdown-css": "^5.9.0",
    "jsdom": "latest",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "single-file-cli": "latest",
    "turndown": "latest",
    "unified": "^11.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
