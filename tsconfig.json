{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "skipLibCheck": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "site/scripts/**/*.ts",
    "workflow/scripts/annotate_tag_guides_fences.ts",
    "workflow/scripts/build_root_pages.ts",
    "workflow/scripts/build_singlefile_index.ts",
    "workflow/scripts/markdown_to_html.ts",
    "workflow/scripts/package_dist_assets.ts",
    "workflow/scripts/render_markdown_file.ts"
  ],
  "exclude": ["dist", "archive", "node_modules"]
}
